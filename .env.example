# Copy to .env to override local Docker settings.
SWOT_WEB_PORT=3000
SWOT_API_PORT=8000
SWOT_SCAN_TIMEOUT=300
SWOT_TOOL_RATE=10
SWOT_MAX_JOBS=4
# Optional comma-separated scope (each domain also allows its subdomains).
SWOT_ALLOWED_DOMAINS=

# Optional intelligence provider keys. Each is empty by default; the matching
# scanner degrades to a clear "token required" result without it. Keys are
# never logged or returned by the API.
SWOT_GITHUB_TOKEN=          # Secret Exposure: GitHub code search
SWOT_SHODAN_KEY=            # Real IP Discovery: Shodan DNS
SWOT_SECURITYTRAILS_KEY=    # Real IP Discovery: historical DNS
SWOT_HIBP_KEY=              # Database Leak Check: breached accounts for a domain
SWOT_LEAKCHECK_KEY=         # Stealer-Log Exposure: LeakCheck
SWOT_INTELX_KEY=            # Stealer-Log Exposure: Intelligence X
SWOT_GOOGLE_API_KEY=        # Dork Search: Google Programmable Search
SWOT_GOOGLE_CSE_ID=         # Dork Search: Programmable Search engine id
